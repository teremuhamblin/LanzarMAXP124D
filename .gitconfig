# .gitconfig — Configuration Git recommandée pour LanzarMAXP124D

## Identité
[user]
    name = Teremu
    email = your-email@example.com

## Couleurs
[color]
    ui = auto

## Alias militaires
[alias]
    st = status -sb
    lg = log --graph --decorate --all --oneline
    co = checkout
    br = branch
    cm = commit -m
    amend = commit --amend
    df = diff --color
    hist = log --pretty=format:"%h %ad | %s%d [%an]" --graph --date=short

## Push / Pull
[push]
    default = current

[pull]
    rebase = true

## Core
[core]
    editor = nano
    autocrlf = input
    excludesfile = ~/.gitignore_global

## Diff
[diff]
    tool = vimdiff

## Merge
[merge]
    tool = vimdiff

## GitHub CLI (si utilisé)
[github]
    user = Teremu
